# yesup-agent-runtime 环境变量示例（前缀 AGENT_）
# 复制为 .env 并按环境填写；.env 严禁提交入 Git！

AGENT_ENV=staging
AGENT_APP_NAME=yesup-agent-runtime
AGENT_PROVIDER_MODE=real  # staging/prod 只能 real；fake 仅自动化测试或明确 DEMO 的 local

# 1. 上游 yesup-core API（Golang 核心服务，受控工具调用目标）
AGENT_CORE_BASE_URL=https://api-staging.agentos-app.app
AGENT_CORE_ACTOR_TOKEN=
AGENT_CORE_TIMEOUT_SECONDS=10
# 固定主体与最小权限。Token 由 Core/Identity 签发，Runtime 不保存签名密钥。
AGENT_CORE_CREDENTIAL_AGENT_ID=agent-test-001
AGENT_CORE_CREDENTIAL_REQUIRED_SCOPES=market:read,account:read,trade:draft
# readiness 会拒绝含这些高权限 Scope 的 Token。
AGENT_CORE_CREDENTIAL_FORBIDDEN_SCOPES=trade:confirm,trade:execute,withdraw:write,withdrawal:write,transfer:write,funding:write,admin,admin:*
# 启动时真实验证，之后按间隔刷新缓存；到期前 24 小时告警。
AGENT_CORE_CREDENTIAL_VALIDATION_INTERVAL_SECONDS=300
AGENT_CORE_CREDENTIAL_EXPIRY_WARNING_SECONDS=86400
# AGENT_STAGING_TOKEN 等旧名称不会被读取，也不能作为部署回退。

# 1c. 火山 RTC + 豆包端到端实时语音（AppKey、AK/SK 只放 Runtime）
# 实时语音渠道开关：volc_rtc = 国内直连 + 降级兜底；openai = 海外 WebRTC 直连
# （含 Azure）；gemini_live = 原生音频 WSS 直连。
AGENT_REALTIME_VOICE_PROVIDER=volc_rtc
# OpenAI Realtime 直连（AGENT_REALTIME_VOICE_PROVIDER=openai 时生效）。
# 实时模型名统一由 AGENT_VOICE_MODEL 决定，不要另设 REALTIME_MODEL。
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.openai.com
# Azure OpenAI：填资源的 /openai 前缀，例如
#   AGENT_OPENAI_BASE_URL=https://<资源名>.openai.azure.com/openai
# 主机名以 .azure.com 结尾时，凭证请求自动改用 `api-key` 头（Azure 不认
# Bearer 形式的 API Key），无需另外配置。
#
# 1d. Gemini Live 原生音频（AGENT_REALTIME_VOICE_PROVIDER=gemini_live 时生效）
# 传输是 WebSocket（BidiGenerateContentConstrained），不是 WebRTC；
# 「音频不经过 Runtime」这条架构约束不变，只是客户端换一种连法。
# 落地前先跑：uv run python scripts/check_gemini_live_connectivity.py
AGENT_GEMINI_API_KEY=
AGENT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AGENT_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# 通话计费口径：每 N 秒 = 1 个时长单元，每 M token = 1 个 token 单元，各自向上
# 取整后相加。配额为 0 表示不限额（此时 /api/voice/session/end 不返回剩余额度）。
AGENT_VOICE_BILLING_SECONDS_PER_UNIT=60
AGENT_VOICE_BILLING_TOKENS_PER_UNIT=1000
AGENT_VOICE_QUOTA_UNITS_PER_USER=0
AGENT_RTC_APP_ID=replace-with-24-char-rtc-app-id
AGENT_RTC_APP_KEY=replace-with-rtc-app-key
AGENT_RTC_TOKEN_TTL_SECONDS=600
# 必须使用最小权限 IAM 子用户 AK/SK，不要使用主账号全权限 Access Key。
AGENT_VOLC_ACCESS_KEY_ID=replace-with-iam-subuser-ak
AGENT_VOLC_SECRET_ACCESS_KEY=replace-with-iam-subuser-sk
# 端到端实时语音服务的 App ID 与配对 Token，不等同于 RTC AppId/AppKey，
# 也不是“语音技术 -> API Key 管理”签发的 TTS/ASR API Key。
AGENT_HUOCHAN_S2S_APP_ID=replace-with-s2s-app-id
AGENT_HUOCHAN_S2S_TOKEN=replace-with-matching-s2s-token
# Runtime 默认使用 S2SConfig.ProviderParams 内置 ASR/TTS（800ms 判停、24kHz
# 单声道 PCM、zh_female_vv_jupiter_bigtts）；不要填写不完整的顶层 ASRConfig/TTSConfig。
AGENT_VOLC_ASR_END_SMOOTH_WINDOW_MS=800
# 普通豆包 TTS/ASR 端点使用的独立 API Key（S2S 主链路不读取它）。
AGENT_HUOCHAN_API_KEY=replace-with-tts-asr-api-key
# 火山异步状态回调；URL 必须公网 HTTPS，Secret 使用独立随机值，不复用 rt_token secret。
AGENT_VOLC_CALLBACK_URL=https://agent-staging.agentos-app.app/v1/agent/volc-callback
AGENT_VOLC_CALLBACK_SECRET=replace-with-independent-32-char-random-secret
# Function Calling 使用独立公网回调与独立 Secret，不与状态回调复用。
AGENT_VOLC_FUNCTION_CALLBACK_URL=https://agent-staging.agentos-app.app/v1/agent/volc-function-callback
AGENT_VOLC_FUNCTION_CALLBACK_SECRET=replace-with-independent-32-char-function-secret
# 火山方舟中已开通 Function Calling 的模型名称与推理接入点 ID。
AGENT_VOLC_ARK_MODEL=replace-with-function-capable-ark-model
AGENT_VOLC_ARK_ENDPOINT_ID=replace-with-ark-endpoint-id
AGENT_VOLC_BOT_JOIN_TIMEOUT_SECONDS=30
AGENT_VOLC_BOT_PRESENCE_POLL_SECONDS=1.0
# Bot/欢迎语已有证据后，等待第一条 ASR/用户字幕的诊断窗口；只标记静默，不自动重启。
AGENT_VOLC_ASR_SILENCE_TIMEOUT_SECONDS=12
AGENT_VOLC_FUNCTION_PROGRESS_DELAY_SECONDS=2
AGENT_RT_WS_BASE=wss://agent-staging.agentos-app.app
AGENT_RT_TOKEN_SECRET=replace-with-long-random-runtime-secret
AGENT_RT_TOKEN_TTL_SECONDS=300
# 交易草稿兜底配置（会话未显式提供时的默认杠杆与滑点）
AGENT_AGENTOS_DEFAULT_LEVERAGE=1
AGENT_AGENTOS_DEFAULT_MAX_SLIPPAGE=0.005
AGENT_AGENTOS_DEFAULT_STRATEGY_ID=strategy_btc_limit_v1

# 2. ElevenLabs：英文人设「Max」的嘴（TTS · 已接通）· 经第三方中转
#    （注：OpenAI Realtime 的 AGENT_OPENAI_API_KEY 等接 Alex 那条链路时再加）
#     ⚠️ BASE_URL 第三方中转只转 TTS+STT、convai 被禁；仅测试，勿走生产客户/交易数据（生产换官方 https://api.elevenlabs.io）。
AGENT_ELEVENLABS_BASE_URL=https://elevenlabsapi.chatshare.org
AGENT_ELEVENLABS_API_KEY=elr_your-elevenlabs-user-key-here
# 【换 Max 嗓子改这行】英文音色 ID（GET /v1/voices 可列全部）：
#   JBFqnCBsd6RMkjVDRZzb George·温暖 / EXAVITQu4vr4xnSDxMaL Sarah·稳重 / IKne3meq5aSn9XLyUdCD Charlie·自信
AGENT_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
AGENT_ELEVENLABS_MODEL_ID=eleven_multilingual_v2   # 一般不用动
AGENT_ELEVENLABS_AGENT_ID=          # convai 用，已弃用（中转禁 convai），留空
# Admin 密钥仅中转后台管理用，runtime 不读取；勿提交真实值。
AGENT_ELEVENLABS_ADMIN_KEY=

# 2d. 文本推理统一网关：自建 New API 中转站（OpenAI 兼容 REST）
# 全部文本推理走这一组配置，代码里没有 provider 分支。三项在 real 模式全部必填，
# 缺任何一项启动即失败 —— 中转站地址或模型名配错会让请求静默打到错误的地方。
AGENT_LLM_BASE_URL=https://api.agentcustomerservice.xyz/v1
AGENT_LLM_API_KEY=sk-your-new-api-key-here
# 【换大脑模型改这行】填站内模型 ID，与上游原名不同，填错直接 404。
# 站内清单以 GET {BASE_URL}/models 为准，2026-08-22 实测 5 个
# （价格为 美元/百万 token，输入/输出）：
#   claude-opus-4-8-low        $5/$25    默认·最便宜且是 Opus 级，缓存 $0.5
#   claude-opus-4-8-thinking   $75/$375  深度推理，贵 15 倍
#   deepseek-v4-flash-max      $75/$75   注意：比 opus-low 贵，别当便宜档用
AGENT_LLM_MODEL=gpt-5.6-terra
# 【Deprecated·2026-09-02 起未再读取】ask_investment_expert 已改为纯数据组装
# （行情快照 + 本地新闻），不再独立跑一次 LLM 分析，这个变量填什么都不影响
# 该工具的行为。保留仅为兼容旧 env 注入，不再需要配置。
AGENT_INVESTMENT_EXPERT_LLM_MODEL=gpt-5.6-terra

# 2d-2. Followin 新闻聚合（MCP 端点，x-api-key 鉴权，GET /v1/agent/news 的数据来源）
# Key 从 Followin 开发者后台申请。provider_mode=real 时此项为**必填**，留空直接
# 启动失败——否则会静默退化成 Fake 新闻，被当成真实资讯喂进交易决策链。
# local+fake 模式下可留空。
AGENT_FOLLOWIN_API_KEY=fl-your-followin-key-here
AGENT_FOLLOWIN_MCP_URL=https://mcp.followin.io/v2/mcp
# 单次调用超时秒（0, 120]；实测单次调用约 2s，默认值即可
AGENT_FOLLOWIN_TIMEOUT_SECONDS=30
# 后台采集循环：默认关闭，部署时需显式打开（沿用原 grok_monitor 的保守风格）
AGENT_NEWS_COLLECT_ENABLED=true
# 采集间隔秒 [60, 3600]。上游 limit 上限 50、无分页，media 源实测约 2 条/分
# → 50 条约 25 分钟耗尽；300s 留 5x 余量
AGENT_NEWS_COLLECT_INTERVAL_SECONDS=300
# 单次拉取条数 [1, 50]，上游硬上限 50，越界会在构造时直接报错
AGENT_NEWS_COLLECT_LIMIT=50
# 一次性冷启动预热：上游无历史回填能力，首次部署置 true 跑一轮后改回 false；
# 滚动重启期间若仍为 true，每个新副本都会再触发一轮（受 round_lock 保护）
AGENT_NEWS_WARMUP_ON_START=false
# /news 未传 time_range 时的护栏 [1, 365]：2 字中文关键词无法用 pg_trgm 索引，
# 必须钉住扫描范围，防止全表扫描失控
AGENT_NEWS_DEFAULT_TIME_RANGE_DAYS=30
# 保留期天数 [1, 3650]。约 2900 条/天，90 天量级可控
AGENT_NEWS_RETENTION_DAYS=90
# 查询限流：按对端 IP 计（不信任可伪造的 X-User-Id）。0 表示不限流
AGENT_NEWS_QUERY_RATE_LIMIT=60
AGENT_NEWS_QUERY_RATE_WINDOW_SECONDS=60

# 语音识别 STT（🎤 对着说话）：elevenlabs=现成即用（Scribe，中文准）；huochan=火山开通「语音识别」后切
AGENT_STT_PROVIDER=elevenlabs

# 2e. 火山 / 豆包 语音合成2.0：默认数字人的嗓子（seed-tts-2.0 · V3 SSE · 单 API Key 自包含，无需 AppID）
# ① API Key：火山控制台 → 语音技术 → API Key 管理（点小眼睛复制）。免费 2 万字符。
# 此 Key 与上面的端到端 S2S Token 是不同凭证，不得互换。
# ② 【换嗓子改这行】以控制台「音色列表」为准；常用大模型 *_bigtts（名称仅供参考）：
#     zh_female_vv_uranus_bigtts 温柔女声(默认) / zh_female_cancan_mars_bigtts 活泼女声
#     zh_female_shuangkuaisisi_moon_bigtts 爽快女声 / zh_male_yunzhou_jupiter_bigtts 沉稳男声
AGENT_HUOCHAN_VOICE_TYPE=zh_female_vv_uranus_bigtts
# ③ 下面两个一般不用动：
AGENT_HUOCHAN_RESOURCE_ID=seed-tts-2.0
AGENT_HUOCHAN_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse

# 3. 基础设施 Redis & PostgreSQL (含 pgvector)
AGENT_REDIS_URL=redis://localhost:6379/0
AGENT_DATABASE_URL=postgresql+asyncpg://username:password@db-host:25060/defaultdb?ssl=require

# 4. 可观测性 (OpenTelemetry)
AGENT_OTEL_ENABLED=false
AGENT_OTEL_EXPORTER_OTLP_ENDPOINT=
